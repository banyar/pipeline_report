# Database (read-only access is enough; a dedicated read-only user is recommended)
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_USERNAME=report_ro
MYSQL_DB_PASSWORD=
MYSQL_DB_DATABASE=rt5

# HTTP listen address
REPORT_HTTP_ADDR=:8090

# Timezone the pipeline services write DATETIMEs in (they use loc=Local).
# "Today" and Age / Stuck are computed in this zone.
REPORT_TZ=Asia/Yangon

# Queue name a successful run counts as "Kept in NOC" for, when its
# before_queue and target_queue are both this queue
REPORT_NOC_QUEUE=Network Operation Center (NOC)

# A run with no state change for this many minutes (and not retrying) is "stuck"
REPORT_STUCK_MINUTES=10

# Max open DB connections for this report's own pool
REPORT_DB_MAX_OPEN=5
